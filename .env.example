# OpenRouter API Key (supports openrouter_api_key or OPENROUTER_API_KEY)
openrouter_api_key=sk-or-v1-your-key-here

# Optional model selection (default: anthropic/claude-3.5-sonnet)
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Safe demo switch: set to false to force deterministic scripted fallback
# LLM_ENABLED=true

