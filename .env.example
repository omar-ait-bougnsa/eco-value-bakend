# OpenRouter API Key (supports openrouter_api_key or OPENROUTER_API_KEY)
openrouter_api_key=sk-or-v1-your-key-here

# Optional model selection (default: anthropic/claude-sonnet-5.5). It must be a model OpenRouter lists and that supports tools.
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Largest answer asked of the model. Without it OpenRouter refuses the request (402) on an account with few credits.
# OPENROUTER_MAX_TOKENS=3000

# Safe demo switch: set to false to force deterministic scripted fallback
# LLM_ENABLED=true

# Knowledge base embeddings: auto (default) | cloud | local | hash
#   auto  = text-embedding-3-small when there is a key above (or OPENAI_API_KEY), else an offline model
#   After changing the model: POST /api/knowledge/reindex (a restart does it too)
# EMBEDDINGS=auto
# OPENAI_API_KEY=sk-your-key-here

